---
import type { CollectionEntry } from "astro:content";
import { HugProject } from "@components/react/HugProject";

// Hug is submitted under Yilun Zhan's own name, so this page stands alone:
// no studio navigation, footer or links into the studio portfolio.
interface Props {
  entry: CollectionEntry<"projects">;
}

const { entry } = Astro.props;
---

<main>
  <HugProject client:load scenes={entry.data.images} />
</main>
