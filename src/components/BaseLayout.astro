---
import BaseHead from "./BaseHead.astro";
import Analytics from "@vercel/analytics/astro";
import SpeedInsights from "@vercel/speed-insights/astro";

interface Props {
  title: string;
  description?: string;
  ogImage?: string;
  canonical?: string;
  noOgPreview?: boolean;
  brand?: boolean;
  favicon?: string;
  /** Document language, e.g. "zh-Hans". */
  lang?: string;
}

const { lang = "en", ...props } = Astro.props;
const noscript = lang.startsWith("zh")
  ? "启用 JavaScript 后浏览效果最佳。"
  : "This page is best experienced with JavaScript enabled.";
---

<!doctype html>
<html lang={lang}>
  <head>
    <BaseHead {...props} />
    <slot name="head" />
  </head>
  <body class="font-body text-white">
    <noscript class="block p-6 font-body text-white/70">
      {noscript}
    </noscript>
    <slot />
    <Analytics />
    <SpeedInsights />
  </body>
</html>
