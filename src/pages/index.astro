---
import { getCollection, type CollectionEntry } from "astro:content";
import BaseLayout from "@components/BaseLayout.astro";
import { HomePage } from "@components/react/HomePage";
import heroBootstrap from "@lib/hero-bootstrap.js?raw";
import { HERO_VIDEO_ASSETS } from "@lib/hero-video-assets";

const entries = await getCollection("projects", (e: CollectionEntry<"projects">) => !e.data.draft);
entries.sort(
  (a: CollectionEntry<"projects">, b: CollectionEntry<"projects">) =>
    (a.data.order ?? 9999) - (b.data.order ?? 9999)
);

const projects = entries.map((e: CollectionEntry<"projects">) => ({
  slug: e.id,
  title: e.data.title,
  subtitle: e.data.subtitle,
  tagline: e.data.tagline,
  category: e.data.category,
  year: e.data.year,
  accent: e.data.accent,
  weight: e.data.weight,
  featured: e.data.featured,
  cover: e.data.cover ?? `/assets/images/projects/${e.id}/01.webp`,
}));
---

<BaseLayout title="YILUN LAB" description="Light. Emotion. Future.">
  <script
    slot="head"
    is:inline
    data-hero-assets={JSON.stringify(
      HERO_VIDEO_ASSETS.map(({ original, poster }) => ({ original, poster }))
    )}
    set:html={heroBootstrap}
  />
  <HomePage client:load projects={projects} />
</BaseLayout>
