---
import { getCollection, type CollectionEntry } from "astro:content";
import BaseLayout from "@components/BaseLayout.astro";
import CaseStudyLayout from "@components/CaseStudyLayout.astro";
import SoftBoundaryLayout from "@components/SoftBoundaryLayout.astro";
import HugLayout from "@components/HugLayout.astro";
import JsonLd from "@components/JsonLd.astro";
import { SITE_URL } from "@lib/data/seo";
import { nextWorkFor } from "@lib/data/project-sequence";

// Case studies stay static in both production and preview deployments.
export const prerender = true;

export async function getStaticPaths() {
  const entries = await getCollection(
    "projects",
    ({ data }: CollectionEntry<"projects">) => !data.draft
  );
  entries.sort(
    (a: CollectionEntry<"projects">, b: CollectionEntry<"projects">) =>
      (a.data.order ?? 9999) - (b.data.order ?? 9999)
  );

  return entries.map((entry: CollectionEntry<"projects">) => ({
    params: { slug: entry.id },
    props: { entry, next: nextWorkFor(entries, entry) },
  }));
}

interface Props {
  entry: CollectionEntry<"projects">;
  next: CollectionEntry<"projects">;
}

const { entry, next } = Astro.props;
const projectUrl = `${SITE_URL}/projects/${entry.id}`;
// Hug is submitted under Yilun Zhan's own name: personal title, creator and
// icon, and no studio breadcrumb.
const personal = entry.id === "hug";

const creativeWorkLd = {
  "@context": "https://schema.org",
  "@type": "CreativeWork",
  "@id": `${projectUrl}#work`,
  name: entry.data.title,
  description: entry.data.tagline,
  url: projectUrl,
  image: `${SITE_URL}/assets/images/projects/${entry.id}/cover.jpg`,
  dateCreated: entry.data.year,
  creator: personal
    ? { "@type": "Person", name: "Yilun Zhan" }
    : { "@id": `${SITE_URL}/about#person` },
  keywords: entry.data.category.map((c: string) => `Light & ${c[0].toUpperCase() + c.slice(1)}`),
};

const breadcrumbLd = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  itemListElement: [
    { "@type": "ListItem", position: 1, name: "Home", item: `${SITE_URL}/` },
    { "@type": "ListItem", position: 2, name: "Works", item: `${SITE_URL}/#works` },
    { "@type": "ListItem", position: 3, name: entry.data.title },
  ],
};
---

<BaseLayout
  title={personal ? `${entry.data.title} by Yilun Zhan` : entry.data.title}
  brand={!personal}
  favicon={personal ? "/assets/images/projects/hug/icon.svg" : undefined}
  description={entry.data.tagline}
  canonical={`/projects/${entry.id}`}
  ogImage={`/assets/images/projects/${entry.id}/cover.jpg`}
>
  <JsonLd data={creativeWorkLd} slot="head" />
  {!personal && <JsonLd data={breadcrumbLd} slot="head" />}
  {
    entry.id === "soft-boundary" ? (
      <SoftBoundaryLayout entry={entry} next={next} />
    ) : entry.id === "hug" ? (
      <HugLayout entry={entry} />
    ) : (
      <CaseStudyLayout entry={entry} next={next} />
    )
  }
</BaseLayout>
